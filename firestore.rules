rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // The accounts allowed into this database. Anyone else is denied by
    // Cloud Firestore itself, not by the app. Add a UID here whenever a
    // new family member joins, then redeploy.
    //   You:      owner-account   3Dg3UMznaWTjrpodHCokaPkjEEt1
    //   Nephew:   nephew-account      LKiCZKuQRPf3BL3NsnSDcRYIKjH2
    //   MatMat:   matmat-account        BWBzQQl3GCeL8w9tjAY0cyxkzcB2
    //   TanTan:   tantan-account        cCMfAF6iowWGHdDN5QYRYabe0ng1
    //   MiKy:     miky-account          CCQve7XDMBf5srFmzUeJXolsIj92
    //   Orange:   orange-account     Wj7CjQLG5QMkc0eziwG8F7XB52p2
    // ------------------------------------------------------------------
    function isMember() {
      return request.auth != null
        && request.auth.uid in [
          '3Dg3UMznaWTjrpodHCokaPkjEEt1',
          'LKiCZKuQRPf3BL3NsnSDcRYIKjH2',
          'BWBzQQl3GCeL8w9tjAY0cyxkzcB2',
          'cCMfAF6iowWGHdDN5QYRYabe0ng1',
          'CCQve7XDMBf5srFmzUeJXolsIj92',
          'Wj7CjQLG5QMkc0eziwG8F7XB52p2'
        ];
    }

    // One small emoji per person per message, kept as a subcollection so
    // message documents stay immutable.
    function validReaction() {
      return request.resource.data.keys().hasOnly(['emoji'])
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() > 0
        && request.resource.data.emoji.size() <= 16;
    }

    // ------------------------------------------------------------------
    // People: one profile per account, used to show names in the chats.
    // You may only ever write your own.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isMember();

      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;

      allow delete: if false;

      // Each phone stores its notification token here, so the notification
      // Cloud Function can reach the right devices. You can only manage
      // your own tokens.
      match /tokens/{tokenId} {
        allow read: if isMember();

        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 512;

        allow delete: if isMember() && request.auth.uid == userId;
      }
    }

    // ------------------------------------------------------------------
    // The family group chat: one shared room, everyone sees everything.
    // ------------------------------------------------------------------
    match /chats/main/messages/{messageId} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'senderId',
             'text',
             'sentAt',
             'replyTo',
             'replyToText',
             'type',
             'imageUrl'
           ])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (request.resource.data.text.size() > 0 ||
            ('type' in request.resource.data &&
             request.resource.data.type == 'image'))
        && (!('type' in request.resource.data) ||
            (request.resource.data.type is string &&
             (request.resource.data.type == 'text' ||
              request.resource.data.type == 'image')))
        && (!('imageUrl' in request.resource.data) ||
            (request.resource.data.imageUrl is string &&
             request.resource.data.imageUrl.size() <= 2050))
        && (!('type' in request.resource.data) ||
            request.resource.data.type != 'image' ||
            (request.resource.data.imageUrl is string &&
             request.resource.data.imageUrl.size() > 0))
        && (!('replyTo' in request.resource.data) ||
            (request.resource.data.replyTo is string
              && request.resource.data.replyTo.size() <= 100))
        && (!('replyToText' in request.resource.data) ||
            (request.resource.data.replyToText is string
              && request.resource.data.replyToText.size() <= 2000));

      // Messages cannot be altered or removed after sending.
      allow update, delete: if false;
    }

    // Reactions to messages in the family room: one doc per (member, message),
    // and only that member can place or remove their own.
    match /chats/main/messages/{messageId}/reactions/{userId} {
      allow read: if isMember();

      allow create, update: if isMember()
        && request.auth.uid == userId
        && validReaction();

      allow delete: if isMember() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // 1:1 conversations. convId is "<uidA>__<uidB>" (sorted, so both
    // people compute the same id). Only those two UIDs can touch it.
    // ------------------------------------------------------------------
    function conversation(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId));
    }

    function isParticipant(convId) {
      return isMember()
        && conversation(convId).data.participants.size() == 2
        && request.auth.uid in conversation(convId).data.participants;
    }

    // Reading a thread that has no conversation document yet is harmless (it
    // is empty - nothing can exist there until the document does), so members
    // may do that freely. The moment content exists, only its two
    // participants may touch it.
    function mayReadThread(convId) {
      return !isMember() ? false :
             !exists(/databases/$(database)/documents/conversations/$(convId)) ? true :
             isParticipant(convId);
    }

    match /conversations/{convId} {
      // Reading the conversation itself is allowed only for its two owners.
      // (A missing document reads as null here and is denied, which is fine:
      // the app never needs to read a conversation it has not created.)
      allow read: if isMember()
        && request.auth.uid in resource.data.participants;

      // Creating is idempotent: the app calls this every time you open a
      // chat, so re-writing the same two participants must also be allowed.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;

      // The same two participants can be re-written again (the app does this
      // every time a chat is opened) but the pair can never be extended or
      // swapped for someone else. Order is irrelevant: either of the two
      // may have created the document, so the stored order can differ from
      // the order this writer passes in.
      allow update: if isMember()
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && ((request.resource.data.participants[0] == resource.data.participants[0]
             && request.resource.data.participants[1] == resource.data.participants[1])
            || (request.resource.data.participants[0] == resource.data.participants[1]
                && request.resource.data.participants[1] == resource.data.participants[0]));

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if mayReadThread(convId);

        allow create: if isParticipant(convId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
               'senderId',
               'text',
               'sentAt',
               'replyTo',
               'replyToText',
               'type',
               'imageUrl'
             ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 ||
              ('type' in request.resource.data &&
               request.resource.data.type == 'image'))
          && (!('type' in request.resource.data) ||
              (request.resource.data.type is string &&
               (request.resource.data.type == 'text' ||
                request.resource.data.type == 'image')))
          && (!('imageUrl' in request.resource.data) ||
              (request.resource.data.imageUrl is string &&
               request.resource.data.imageUrl.size() <= 2050))
          && (!('type' in request.resource.data) ||
              request.resource.data.type != 'image' ||
              (request.resource.data.imageUrl is string &&
               request.resource.data.imageUrl.size() > 0))
          && (!('replyTo' in request.resource.data) ||
              (request.resource.data.replyTo is string
                && request.resource.data.replyTo.size() <= 100))
          && (!('replyToText' in request.resource.data) ||
              (request.resource.data.replyToText is string
                && request.resource.data.replyToText.size() <= 2000));

        allow update, delete: if false;

        // Reactions inside a 1:1 thread: as with the group, each member can
        // only manage their own reaction.
        match /reactions/{userId} {
          allow read: if isParticipant(convId);

          allow create, update: if isParticipant(convId)
            && request.auth.uid == userId
            && validReaction();

          allow delete: if isParticipant(convId) && request.auth.uid == userId;
        }
      }
    }

    // Everything else is off limits. Do not remove this line.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}