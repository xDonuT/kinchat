rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // The two accounts allowed into this database. Anyone else gets
    // denied by Cloud Firestore itself, not by the app.
    //   You:      owner-account
    //   Nephew:   nephew-account
    // (Re-send them from README.md if you ever lose the passwords.)
    // ------------------------------------------------------------------
    function isMember() {
      return request.auth != null
        && request.auth.uid in [
          '3Dg3UMznaWTjrpodHCokaPkjEEt1',
          'LKiCZKuQRPf3BL3NsnSDcRYIKjH2'
        ];
    }

    // The only writable data in the whole database: chat messages.
    match /chats/main/messages/{messageId} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // Messages cannot be altered or removed after sending.
      allow update, delete: if false;
    }

    // Everything else is off limits. Do not remove this line.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}