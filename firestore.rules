rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // The accounts allowed into this database. Anyone else is denied by
    // Cloud Firestore itself, not by the app. Add a UID here whenever a
    // new family member joins, then redeploy.
    //   Owner:    3Dg3UMznaWTjrpodHCokaPkjEEt1
    //   Nephew:   LKiCZKuQRPf3BL3NsnSDcRYIKjH2
    //   MatMat:   BWBzQQl3GCeL8w9tjAY0cyxkzcB2
    //   TanTan:   cCMfAF6iowWGHdDN5QYRYabe0ng1
    //   MiKy:     CCQve7XDMBf5srFmzUeJXolsIj92
    //   Orange:   Wj7CjQLG5QMkc0eziwG8F7XB52p2
    // ------------------------------------------------------------------
    function isMember() {
      return request.auth != null
        && request.auth.uid in [
          '3Dg3UMznaWTjrpodHCokaPkjEEt1',
          'LKiCZKuQRPf3BL3NsnSDcRYIKjH2',
          'BWBzQQl3GCeL8w9tjAY0cyxkzcB2',
          'cCMfAF6iowWGHdDN5QYRYabe0ng1',
          'CCQve7XDMBf5srFmzUeJXolsIj92',
          'Wj7CjQLG5QMkc0eziwG8F7XB52p2'
        ];
    }

    // One small emoji per person per message, kept as a subcollection so
    // message documents stay immutable.
    function validReaction() {
      return request.resource.data.keys().hasOnly(['emoji'])
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() > 0
        && request.resource.data.emoji.size() <= 16;
    }

    // Optional quote fields, shared by text and photo messages.
    function validReplyFields() {
      return (!('replyTo' in request.resource.data) ||
          (request.resource.data.replyTo is string
            && request.resource.data.replyTo.size() <= 100))
        && (!('replyToText' in request.resource.data) ||
          (request.resource.data.replyToText is string
            && request.resource.data.replyToText.size() <= 2000));
    }

    // The original message shape: a non-empty body capped at 2000 chars.
    function validTextMessage() {
      return request.resource.data.keys().hasOnly([
           'senderId',
           'text',
           'sentAt',
           'replyTo',
           'replyToText'
         ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && validReplyFields();
    }

    // A photo message has no body: the image URL/path and its dimensions are
    // required instead, and the file must sit beside its own message.
    function validImageMessage(convId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
           'senderId',
           'type',
           'imageUrl',
           'imagePath',
           'imageWidth',
           'imageHeight',
           'sentAt',
           'replyTo',
           'replyToText'
         ])
        && d.type == 'image'
        && d.imageUrl is string
        && d.imageUrl.size() > 0
        && d.imageUrl.size() <= 2048
        && d.imagePath is string
        && d.imagePath.split('/').size() == 4
        && d.imagePath.split('/')[0] == 'conversations'
        && d.imagePath.split('/')[1] == convId
        && d.imagePath.split('/')[2] == 'messages'
        && d.imagePath.split('/')[3].size() > 0
        && d.imageWidth is int
        && d.imageWidth > 0
        && d.imageWidth <= 10000
        && d.imageHeight is int
        && d.imageHeight > 0
        && d.imageHeight <= 10000
        && validReplyFields();
    }

    // A game message only points at a Knucklebones document; the game is in the
    // games subcollection and can be updated while this message stays immutable.
    function validGameMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['senderId', 'type', 'gameId', 'sentAt'])
        && d.type == 'game'
        && d.gameId is string
        && d.gameId.size() > 0
        && d.gameId.size() <= 100;
    }

    // ------------------------------------------------------------------
    // People: one profile per account, used to show names in the chats.
    // You may only ever write your own.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isMember();

      allow create, update: if isMember()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;

      allow delete: if false;

      // Each phone stores its notification token here, so the notification
      // Cloud Function can reach the right devices. You can only manage
      // your own tokens.
      match /tokens/{tokenId} {
        allow read: if isMember();

        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 512;

        allow delete: if isMember() && request.auth.uid == userId;
      }
    }

    // ------------------------------------------------------------------
    // 1:1 conversations. convId is "<uidA>__<uidB>" (sorted, so both
    // people compute the same id). Only those two UIDs can touch it.
    // ------------------------------------------------------------------
    function conversation(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId));
    }

    function isParticipant(convId) {
      return isMember()
        && conversation(convId).data.participants.size() == 2
        && request.auth.uid in conversation(convId).data.participants;
    }

    // Reading a thread that has no conversation document yet is harmless (it
    // is empty - nothing can exist there until the document does), so members
    // may do that freely. The moment content exists, only its two
    // participants may touch it.
    function mayReadThread(convId) {
      return !isMember() ? false :
             !exists(/databases/$(database)/documents/conversations/$(convId)) ? true :
             isParticipant(convId);
    }

    function validColumn(column) {
      return column is list
        && column.size() <= 3
        && (column.size() < 1
            || (column[0] is int && column[0] >= 1 && column[0] <= 6))
        && (column.size() < 2
            || (column[1] is int && column[1] >= 1 && column[1] <= 6))
        && (column.size() < 3
            || (column[2] is int && column[2] >= 1 && column[2] <= 6));
    }

    function validColumns(columns) {
      return columns is list
        && columns.size() == 3
        && validColumn(columns[0])
        && validColumn(columns[1])
        && validColumn(columns[2]);
    }

    // Shape of a Knucklebones game. Turn order and scoring live in
    // KnuckleEngine; these rules keep the document well-formed and limited
    // to the two people in the conversation.
    function validKnuckle() {
      let d = request.resource.data;
      return d.keys().hasOnly([
           'participants',
           'createdBy',
           'status',
           'turn',
           'pendingRoll',
           'players',
           'winner',
           'createdAt',
           'updatedAt'
         ])
        && d.participants is list
        && d.participants.size() == 2
        && request.auth.uid in d.participants
        && d.createdBy is string
        && d.createdBy in d.participants
        && d.status is string
        && (d.status == 'active' || d.status == 'finished')
        && d.turn is string
        && d.turn in d.participants
        && d.pendingRoll is int
        && d.pendingRoll >= 0
        && d.pendingRoll <= 6
        && d.winner is string
        && (d.winner == '' || d.winner == 'draw' || d.winner in d.participants)
        && d.players is list
        && d.players.size() == 2
        && d.players[0] is map
        && d.players[1] is map
        && d.players[0].keys().hasOnly(['uid', 'col0', 'col1', 'col2'])
        && d.players[1].keys().hasOnly(['uid', 'col0', 'col1', 'col2'])
        && d.players[0].uid is string
        && d.players[1].uid is string
        && d.players[0].uid in d.participants
        && d.players[1].uid in d.participants
        && d.players[0].uid != d.players[1].uid
        && validColumn(d.players[0].col0)
        && validColumn(d.players[0].col1)
        && validColumn(d.players[0].col2)
        && validColumn(d.players[1].col0)
        && validColumn(d.players[1].col1)
        && validColumn(d.players[1].col2);
    }

    // ------------------------------------------------------------------
    // Handle index: lowercase name -> uid, so a member can add someone by
    // typing their exact name. Only exact lookups (get) are allowed; the
    // collection cannot be listed, so it never leaks the member list.
    // ------------------------------------------------------------------
    match /handles/{handle} {
      allow get: if isMember();
      allow list: if false;

      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Contacts (friend requests). The id is the same sorted "<uidA>__<uidB>"
    // pair as the 1:1 conversation. Someone requests, the other accepts, and
    // only then may the two open a private chat or message each other.
    // ------------------------------------------------------------------
    function contactDoc(pairId) {
      return get(/databases/$(database)/documents/contacts/$(pairId));
    }

    function areContacts(pairId) {
      return exists(/databases/$(database)/documents/contacts/$(pairId))
        && contactDoc(pairId).data.status == 'accepted';
    }

    match /contacts/{pairId} {
      allow read: if isMember()
        && request.auth.uid in resource.data.participants;

      // You may only ever send a request as yourself, and only while pending.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly([
             'participants',
             'requestedBy',
             'status',
             'updatedAt'
           ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      // Accepting is only allowed for the *other* person on a pending request,
      // and must not change who is involved or who asked.
      allow update: if isMember()
        && request.auth.uid in resource.data.participants
        && resource.data.status == 'pending'
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.keys().hasOnly([
             'participants',
             'requestedBy',
             'status',
             'updatedAt'
           ])
        && request.resource.data.status == 'accepted'
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.requestedBy == resource.data.requestedBy;

      // Decline a request, cancel your own, or remove an accepted contact.
      allow delete: if isMember()
        && request.auth.uid in resource.data.participants;
    }

    match /conversations/{convId} {
      // Reading the conversation itself is allowed only for its two owners.
      // (A missing document reads as null here and is denied, which is fine:
      // the app never needs to read a conversation it has not created.)
      allow read: if isMember()
        && request.auth.uid in resource.data.participants;

      // Creating is idempotent: the app calls this every time you open a
      // chat, so re-writing the same two participants must also be allowed.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && areContacts(convId);

      // The same two participants can be re-written again (the app does this
      // every time a chat is opened) but the pair can never be extended or
      // swapped for someone else. Order is irrelevant: either of the two
      // may have created the document, so the stored order can differ from
      // the order this writer passes in.
      allow update: if isMember()
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasOnly(['participants', 'updatedAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && ((request.resource.data.participants[0] == resource.data.participants[0]
             && request.resource.data.participants[1] == resource.data.participants[1])
            || (request.resource.data.participants[0] == resource.data.participants[1]
                && request.resource.data.participants[1] == resource.data.participants[0]))
        && areContacts(convId);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if mayReadThread(convId);

        allow create: if isParticipant(convId)
          && request.resource.data.senderId == request.auth.uid
          && (validTextMessage() || validImageMessage(convId) || validGameMessage());

        allow update: if false;
        allow delete: if isParticipant(convId);

        // Reactions inside a 1:1 thread: each member can only place their
        // own, but both may delete them so clearing the thread (which removes
        // everyone's reactions) is allowed.
        match /reactions/{userId} {
          allow read: if isParticipant(convId);

          allow create, update: if isParticipant(convId)
            && request.auth.uid == userId
            && validReaction();

          allow delete: if isParticipant(convId);
        }
      }

      match /games/{gameId} {
        allow read: if isParticipant(convId);

        allow create: if isParticipant(convId)
          && validKnuckle()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.turn == request.auth.uid;

        allow update: if isParticipant(convId)
          && validKnuckle()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.participants == resource.data.participants
          && (resource.data.status == 'finished'
              || request.auth.uid == resource.data.turn);

        allow delete: if isParticipant(convId);
      }
    }

    // Everything else is off limits. Do not remove this line.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}