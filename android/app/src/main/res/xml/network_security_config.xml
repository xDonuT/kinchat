<?xml version="1.0" encoding="utf-8"?>
<!--
  Firebase emulators speak plain HTTP. Android 9+ blocks cleartext by default,
  so allow it for the Android emulator's host aliases and nothing else.
  Production Firebase traffic stays HTTPS-only under base-config below.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- LAN emulator host (physical phone): Firebase's SDK rejects loopback on
             real devices, so the PC's IP is the only route that survives its
             127.0.0.1 -> 10.0.2.2 rewrite. -->
        <domain includeSubdomains="false">192.168.100.11</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>